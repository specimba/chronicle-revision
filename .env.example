# ==============================================================================
# CHRONICLE // REVISION WORKSPACE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI / AGENT API
# ------------------------------------------------------------------------------
# Required for Gemini 3.8 Flash model reasoning, RevisionPatch parsing,
# and Google ADK agent orchestration.
# Configured via AI Studio Settings / Secrets.
GEMINI_API_KEY=

# Hosted service URL (automatically set by Cloud Run runtime)
APP_URL=

# ------------------------------------------------------------------------------
# 2. CLICKHOUSE OFFICIAL MCP EVIDENCE PLANE (READ-ONLY)
# ------------------------------------------------------------------------------
# Remote official mcp-clickhouse server endpoint (Streamable HTTP transport)
# Used by Google ADK Agent for read-only scene/invariant/ripple exploration.
# NEVER has write credentials.
CLICKHOUSE_MCP_URL=
CLICKHOUSE_MCP_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. CLICKHOUSE DIRECT WRITER PATH (HUMAN PROMOTION ROUTE ONLY)
# ------------------------------------------------------------------------------
# Strictly reserved for the deterministic server-side human promotion route.
# Append-only semantics enforced: INSERT only; UPDATE/DELETE strictly forbidden.
# Never accessed by the agent, MCP, or exposed client-side.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_WRITER_USER=
CLICKHOUSE_WRITER_PASSWORD=
CLICKHOUSE_SECURE=true
